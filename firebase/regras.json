{
  "rules": {
    ".read": false,
    ".write": false,
    "ranking": {
      ".read": true,
      ".indexOn": [
        "pontos"
      ],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['nome', 'pontos', 'quando', 'uid'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "pontos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000"
        },
        "quando": {
          ".validate": "newData.val() === now"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "pedidos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
        },
        "segundos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "cargo": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "disp": {
          ".validate": "newData.val() === 'celular' || newData.val() === 'computador'"
        },
        "versao": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "semanal": {
      ".read": true,
      "$semana": {
        ".indexOn": [
          "pontos"
        ],
        ".validate": "$semana.matches(/^[0-9]{4}-W[0-9]{2}$/)",
        "$id": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['nome', 'pontos', 'quando', 'uid'])",
          "nome": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "pontos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000"
          },
          "quando": {
            ".validate": "newData.val() === now"
          },
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "pedidos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
          },
          "segundos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "cargo": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "disp": {
            ".validate": "newData.val() === 'celular' || newData.val() === 'computador'"
          },
          "versao": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "$outro": {
            ".validate": false
          }
        }
      }
    }
  }
}
