{
  "rules": {
    ".read": false,
    ".write": false,
    "ranking": {
      ".read": true,
      ".indexOn": [
        "pontos"
      ],
      "$k": {
        ".write": "auth != null && newData.parent().parent().child('donos').child($k).val() === auth.uid && (!data.exists() || newData.child('pontos').val() >= data.child('pontos').val())",
        ".validate": "newData.hasChildren(['nome', 'pontos', 'quando'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "pontos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000"
        },
        "quando": {
          ".validate": "newData.val() === now"
        },
        "pedidos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
        },
        "segundos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "cargo": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "disp": {
          ".validate": "newData.val() === 'celular' || newData.val() === 'computador'"
        },
        "versao": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "semanal": {
      ".read": true,
      "$semana": {
        ".indexOn": [
          "pontos"
        ],
        ".validate": "$semana.matches(/^[0-9]{4}-W[0-9]{2}$/)",
        "$k": {
          ".write": "auth != null && newData.parent().parent().parent().child('donos').child($k).val() === auth.uid && (!data.exists() || newData.child('pontos').val() >= data.child('pontos').val())",
          ".validate": "newData.hasChildren(['nome', 'pontos', 'quando'])",
          "nome": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "pontos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000"
          },
          "quando": {
            ".validate": "newData.val() === now"
          },
          "pedidos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
          },
          "segundos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "cargo": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "disp": {
            ".validate": "newData.val() === 'celular' || newData.val() === 'computador'"
          },
          "versao": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "$outro": {
            ".validate": false
          }
        }
      }
    },
    "donos": {
      ".read": true,
      "$k": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid || newData.parent().parent().child('provas').child($k).child(auth.uid).val() === root.child('segredos').child($k).val())",
        ".validate": "newData.val() === auth.uid && $k.matches(/^[a-z0-9]{1,24}$/)"
      }
    },
    "segredos": {
      "$k": {
        ".write": "auth != null && !data.exists() && newData.parent().parent().child('donos').child($k).val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8"
      }
    },
    "provas": {
      "$k": {
        "$uid": {
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 8"
        }
      }
    }
  }
}
